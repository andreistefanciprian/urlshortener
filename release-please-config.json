{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-title-pattern": "chore${scope}: release ${component} ${version}",
  "separate-pull-requests": true,
  "packages": {
    "api-gateway": {
      "release-type": "simple",
      "component": "api-gateway",
      "tag-name": "api-gateway-v${version}",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md"
    },
    "demo": {
      "release-type": "simple",
      "component": "demo",
      "tag-name": "demo-v${version}",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md"
    },
    "url-read": {
      "release-type": "simple",
      "component": "url-read",
      "tag-name": "url-read-v${version}",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md"
    },
    "url-gen": {
      "release-type": "simple",
      "component": "url-gen",
      "tag-name": "url-gen-v${version}",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md"
    },
    "frontend": {
      "release-type": "simple",
      "component": "frontend",
      "tag-name": "frontend-v${version}",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
