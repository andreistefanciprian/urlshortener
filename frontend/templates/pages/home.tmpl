{{define "title"}}View Links{{end}}

{{define "main"}}

<div class="container">
    <table class="table table-striped">
    <thead>
        <tr>
            <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#createShortLink">Add link</button>
        </tr>

        <!-- Modal Create Short Link-->
        <div class="modal fade" id="createShortLink" tabindex="-1" aria-labelledby="createShortLinkLabel" aria-hidden="true">
            <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                <h5 class="modal-title" id="createShortLinkLabel">Enter your destination URL</h5>
                </div>

                <form id="createShortLinkForm" action="/" method="POST">
                <div class="modal-body">

                    <div class="input-group has-validation mb-3">
                    <span class="input-group-text" id="basic-addon1">Long URL</span>
                    <input id="createLongURL" type="text" class="form-control" placeholder="Long URL required" aria-label="longURL" aria-describedby="basic-addon1 createLongUrlFeedback" name="longURL" required>
                    <div class="invalid-feedback" id="createLongUrlFeedback"></div>
                    </div>

                </div>

                <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                
                    <input class="btn btn-outline-primary btn-sm" type="submit" name="create" value="Create">
                
                </div>
                </form>
                
            </div>
            </div>
        </div>        
        <tr>
            <th scope="col">Short Link</th>
            <th scope="col">Long Link</th>
            <th scope="col">Delete</th>
        </tr>
    </thead>
    <tbody>
        {{range .}}
            <tr>
                <td><a href="{{.ShortUrl}}" target="_blank" rel="noopener noreferrer" class="small fw-bold">{{.StripHTTPSchemeFromShortUrl}}</a></td>
                <td>{{.StripHTTPSchemeFromLongUrl}}</td>
                <td><button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteLink{{.ShortUrl}}">Delete</button></td>
            </tr>

            <!-- Modal Delete Link-->
            <div class="modal fade" id="deleteLink{{.ShortUrl}}" tabindex="-1" aria-labelledby="deleteLinkLabel" aria-hidden="true">
                <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                    <h5 class="modal-title" id="deleteLinkLabel">Delete Short URL</h5>
                    </div>
                    <div class="modal-body">
                    Are you sure you want to delete short URL "{{.ShortUrl}}"?
                    </div>
                    
                    <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <form action="/" method="POST">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" class="form-control" placeholder="" aria-label="ShortUrl" aria-describedby="basic-addon1" name="ShortUrl" value="{{.ShortUrl}}">
                        <input class="btn btn-outline-danger btn-sm" type="submit" name="delete" value="Delete">
                    </form>
                    
                    </div>
                </div>
                </div>
            </div>

        {{end}}

    </tbody>
    </table>
</div>

<script>
    // Intercept create form submit to display API-gateway validation messages using invalid-feedback
    (function attachCreateHandler() {
        var form = document.getElementById('createShortLinkForm');
        if (!form) return;

        // Cache DOM elements once
        var modalEl = document.getElementById('createShortLink');
        var longURLInput = document.getElementById('createLongURL');
        var feedbackEl = document.getElementById('createLongUrlFeedback');
        var submitBtn = form.querySelector('input[type="submit"][name="create"]');

        // Helper to clear validation state (do not clear value)
        function clearCreateValidation() {
            if (longURLInput) longURLInput.classList.remove('is-invalid');
            if (feedbackEl) { feedbackEl.textContent = ''; }
        }

        // Helper to fully reset the form (clear value + validation)
        function resetCreateForm() {
            clearCreateValidation();
            if (longURLInput) longURLInput.value = '';
        }

        // When the modal closes, reset previous state and value
        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', resetCreateForm);
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            // clear previous validation state
            clearCreateValidation();

            try {
                if (submitBtn) submitBtn.disabled = true;
                var fd = new FormData(form);
                fd.set('create', 'Create'); // ensure flag is present

                fetch('/', {
                    method: 'POST',
                    body: fd
                })
                .then(function (res) {
                    // fetch follows redirects by default; res.redirected is sufficient
                    if (res.redirected || res.ok) {
                        window.location.reload();
                        return; // no need to resolve; reload interrupts execution
                    }
                    return res.text().then(function (text) {
                        var msg = (text || '').trim() || 'Failed to create short link.';
                        if (feedbackEl) {
                            feedbackEl.textContent = msg;
                        }
                        if (longURLInput) {
                            longURLInput.classList.add('is-invalid');
                            longURLInput.focus();
                        }
                    });
                })
                .catch(function () {
                    if (feedbackEl) { feedbackEl.textContent = 'Network error while creating short link. Please try again.'; }
                    if (longURLInput) longURLInput.classList.add('is-invalid');
                })
                .finally(function () {
                    if (submitBtn) submitBtn.disabled = false;
                });
            } catch (_) {
                // As a last resort, fall back to normal form submission
                if (submitBtn) submitBtn.disabled = false;
            }
        });

        // Clear validation state when user edits input
        if (longURLInput) {
            longURLInput.addEventListener('input', function () {
                clearCreateValidation();
            });
        }
    })();
</script>

{{end}}