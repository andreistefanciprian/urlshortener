{{define "title"}}View Links{{end}}

{{define "main"}}

<div class="container">
    <table class="table table-striped">
    <thead>
        <tr>
            <button type="button" class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#createShortLink">Add link</button>
        </tr>

        <!-- Modal Create Short Link-->
        <div class="modal fade" id="createShortLink" tabindex="-1" aria-labelledby="createShortLinkLabel" aria-hidden="true">
            <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                <h5 class="modal-title" id="createShortLinkLabel">Enter your destination URL</h5>
                </div>

                <form action="/" method="POST">
                <div class="modal-body">

                    <!-- Live alert placeholder for create short link -->
                    <div id="createAlertPlaceholder" class="mb-2"></div>

                    <div class="input-group mb-3">
                    <span class="input-group-text" id="basic-addon1">Long URL</span>
                    <input type="text" class="form-control" placeholder="Long URL required" aria-label="longURL" aria-describedby="basic-addon1" name="longURL" required>
                    </div>
                
                </div>

                <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                
                    <input class="btn btn-outline-primary btn-sm" type="submit" name="create" value="Create">
                
                </div>
                </form>
                
            </div>
            </div>
        </div>        
        <tr>
            <th scope="col">Short Link</th>
            <th scope="col">Long Link</th>
            <th scope="col">Delete</th>
        </tr>
    </thead>
    <tbody>
        {{range .}}
            <tr>
                <td><a href="{{.ShortUrl}}" target="_blank" rel="noopener noreferrer" class="small fw-bold">{{.StripHTTPSchemeFromShortUrl}}</a></td>
                <td>{{.StripHTTPSchemeFromLongUrl}}</td>
                <td><button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteLink{{.ShortUrl}}">Delete</button></td>
            </tr>

            <!-- Modal Delete Link-->
            <div class="modal fade" id="deleteLink{{.ShortUrl}}" tabindex="-1" aria-labelledby="deleteLinkLabel" aria-hidden="true">
                <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                    <h5 class="modal-title" id="deleteLinkLabel">Delete Short URL</h5>
                    </div>
                    <div class="modal-body">
                    Are you sure you want to delete short URL "{{.ShortUrl}}"?
                    </div>
                    
                    <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                    <form action="/" method="POST">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" class="form-control" placeholder="" aria-label="ShortUrl" aria-describedby="basic-addon1" name="ShortUrl" value="{{.ShortUrl}}">
                        <input class="btn btn-outline-danger btn-sm" type="submit" name="delete" value="Delete">
                    </form>
                    
                    </div>
                </div>
                </div>
            </div>

        {{end}}

    </tbody>
    </table>
</div>

<script>
    // Utility: create and inject a Bootstrap alert
    function showCreateAlert(type, message) {
        const placeholder = document.getElementById('createAlertPlaceholder');
        if (!placeholder) return;
        placeholder.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
    }

    // Intercept create form submit to validate and show live alerts
    (function attachCreateHandler() {
        const modalEl = document.getElementById('createShortLink');
        if (!modalEl) return;
        const form = modalEl.querySelector('form');
        if (!form) return;

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const submitBtn = form.querySelector('input[type="submit"][name="create"]');
            const longURLInput = form.querySelector('input[name="longURL"]');
            const longURL = (longURLInput?.value || '').trim();

            // Submit via fetch to the same endpoint, so the frontend can proxy to the gateway
            try {
                submitBtn && (submitBtn.disabled = true);
                const fd = new FormData(form);
                fd.set('create', 'Create'); // ensure flag is present

                const res = await fetch('/', {
                    method: 'POST',
                    body: fd
                });

                if (res.ok) {
                    // Refresh the list and close the modal
                    window.location.reload();
                    return;
                }

                const text = await res.text();
                // Show gateway error or a generic message
                showCreateAlert('danger', text || 'Failed to create short link.');
            } catch (err) {
                showCreateAlert('danger', 'Network error while creating short link. Please try again.');
            } finally {
                submitBtn && (submitBtn.disabled = false);
            }
        });
    })();
</script>

{{end}}