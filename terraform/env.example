# Service account impersonated by Terraform for all API calls.
# Used by the Google provider directly (no SA key required).
# Authenticate first: gcloud auth application-default login
GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=terraform-admin@<gcp-project>.iam.gserviceaccount.com

# Google Cloud Project ID
# Replace with your GCP project ID
TF_VAR_gcp_project=your-gcp-project-id

# Google Cloud Region
# Replace with your preferred region (e.g., australia-southeast1)
TF_VAR_gcp_region=your-gcp-region

# Terraform State Storage Bucket Name
# Replace with your unique bucket name for storing Terraform state
TF_VAR_tfstate_bucket=your-terraform-state-bucket-name

TF_LOG=INFO

# Google Cloud Zone (required for cloudflared_vm)
# Replace with a zone in your chosen region (e.g., australia-southeast1-a)
TF_VAR_gcp_zone=your-gcp-zone

# Cloudflare (required for cloudflare layer)
TF_VAR_cloudflare_account_id=your-cloudflare-account-id
TF_VAR_cloudflare_api_token=your-cloudflare-api-token
TF_VAR_cloudflare_zone_id=your-cloudflare-zone-id
TF_VAR_cloudflare_domain=your-cloudflare-domain