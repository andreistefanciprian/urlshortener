{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["regex"],

  "regexManagers": [
    {
      "description": "Bump Helm chart targetRevision in Argo CD Applications from GHCR OCI charts",
      "fileMatch": ["^k8s/argocd/.*\\.ya?ml$"],
      "matchStrings": [
        "repoURL:\\s*oci://ghcr\\.io/(?<path>[^\\s#]+)[\\s\\S]*?\\n\\s*chart:\\s*(?<chart>[^\\s#]+)[\\s\\S]*?\\n\\s*targetRevision:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/{{{path}}}",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update image digest for Docker Hub images (with or without docker.io prefix)",
      "fileMatch": ["^k8s/argocd/.*\\.ya?ml$"],
      "matchStrings": [
        "(?<repoIndent>\\s*)repository:\\s*(?<prefix>(?:docker\\.io/|index\\.docker\\.io/)?)(?<depName>andreistefanciprian/[^\\s#]+)\\s*\\n(?<digestIndent>\\s*)digest:\\s*(?<currentDigest>sha256:[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "docker.io/{{{depName}}}",
      "versioningTemplate": "loose",
      "currentValueTemplate": "latest",
      "autoReplaceStringTemplate": "{{{repoIndent}}}repository: {{{prefix}}}{{{depName}}}\n{{{digestIndent}}}digest: {{{newDigest}}}"
    },
    {
      "description": "Update image tag in Argo CD Applications when tag is present",
      "fileMatch": ["^k8s/argocd/.*\\.ya?ml$"],
      "matchStrings": [
        "repository:\\s*(?<depName>[^\\s#]+)[\\s\\S]*?\\n\\s*tag:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "        repository: {{{depName}}}\\n        tag: {{{newValue}}}"
    }
  ],

  "packageRules": [
    {
      "matchDatasources": ["helm", "docker"],
      "automerge": false,
      "prCreation": "immediate",
      "stabilityDays": 0
    },
    {
      "description": "Commit messages for GHCR OCI Helm charts",
      "matchManagers": ["regex"],
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^ghcr\\.io/andreistefanciprian/urlshortener/"],
      "commitMessagePrefix": "helm",
      "commitMessageAction": "bump",
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Commit messages for other container images",
      "matchManagers": ["regex"],
      "matchDatasources": ["docker"],
      "excludePackagePatterns": ["^ghcr\\.io/andreistefanciprian/urlshortener/"],
      "commitMessagePrefix": "image:",
      "commitMessageAction": "bump",
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Always pin digests for images handled by regex manager",
      "matchManagers": ["regex"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    }
  ]
}
