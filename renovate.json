{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["regex"],
  "regexManagers": [
    {
      "description": "Bump Helm chart targetRevision in Argo CD Applications (OCI charts on GHCR via docker tags)",
      "fileMatch": ["^k8s/argocd/.*\\.ya?ml$"],
      "matchStrings": [
        "repoURL:\\s*oci://ghcr\\.io/(?<path>[^\\s]+)[\\s\\S]*?chart:\\s*[^\\s]+[\\s\\S]*?targetRevision:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/{{{path}}}",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update image.digest in Argo CD Applications (digest-only, no tag)",
      "fileMatch": ["^k8s/argocd/.*\\.ya?ml$"],
      "matchStrings": [
        "(?<block>repository:\\s*(?<depName>[^\\s]+)[\\s\\S]*?digest:\\s*(?<currentDigest>sha256:[^\\s#]+))"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "          repository: {{{depName}}}\\n          digest: {{{newDigest}}}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["helm", "docker"],
      "automerge": false,
      "prCreation": "immediate",
      "stabilityDays": 0
    },
    {
      "description": "Custom commit message for GHCR OCI Helm charts (PR title derived)",
      "matchManagers": ["regex"],
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^ghcr\\.io/andreistefanciprian/urlshortener/"],
      "commitMessagePrefix": "helm",
      "commitMessageAction": "bump",
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Custom commit message for container images (PR title derived)",
      "matchManagers": ["regex"],
      "matchDatasources": ["docker"],
      "excludePackagePatterns": ["^ghcr\\.io/andreistefanciprian/urlshortener/"],
      "commitMessagePrefix": "image: ",
      "commitMessageAction": "bump",
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Pin digests for docker images found by regex manager",
      "matchManagers": ["regex"],
      "matchDatasources": ["docker"],
      "pinDigests": true
    }
  ]
}
