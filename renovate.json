{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["regex"],
  "ignorePaths": [
    "api-gateway/infra/**",
    "frontend/infra/**",
    "url-gen/infra/**",
    "url-read/infra/**"
  ],

  "regexManagers": [
    {
      "description": "Bump Helm chart targetRevision in Argo CD Applications from GHCR OCI charts",
      "fileMatch": ["^k8s/argocd/.*\\.ya?ml$"],
      "matchStrings": [
        "repoURL:\\s*oci://ghcr\\.io/(?<path>[^\\s#]+)[\\s\\S]*?\\n\\s*chart:\\s*(?<chart>[^\\s#]+)[\\s\\S]*?\\n\\s*targetRevision:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/{{{path}}}",
      "versioningTemplate": "semver"
    },
    {
      "description": "Update image digests in k8s/values/*.values.yaml (tie digest to tag)",
      "fileMatch": ["^k8s/values/.*\\.values\\.ya?ml$"],
      "matchStrings": [
        "repository:\\s*(?<repo>andreistefanciprian\\/[a-z0-9-]+)[\\s\\S]*?\\n\\s*digest:\\s*sha256:(?<currentValue>[a-f0-9]{64})[\\s\\S]*?\\n\\s*tag:\\s*(?<tag>[^\\s#]+)"
      ],
      "depNameTemplate": "{{{repo}}}:{{{tag}}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      "matchDatasources": ["helm", "docker"],
      "automerge": true,
      "prCreation": "immediate",
      "stabilityDays": 0
    },
    {
      "description": "Commit messages for GHCR OCI Helm charts",
      "matchManagers": ["regex"],
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["^ghcr\\.io/andreistefanciprian/urlshortener/"],
      "commitMessagePrefix": "helm",
      "commitMessageAction": "bump",
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Commit messages for image digest updates in k8s/values",
      "matchManagers": ["regex"],
      "matchPackagePatterns": [
        "^andreistefanciprian/urlshortener-(api-gateway|frontend|url-gen|url-read)$"
      ],
      "commitMessagePrefix": "image",
      "commitMessageAction": "pin",
      "commitMessageTopic": "{{depName}} digest",
      "commitMessageExtra": "to {{newDigest}}"
    }
  ]
}
